    {
      "category": "formula",
      "exact_item_id": "f17",
      "literal": "$$\n(x_1,x_2)\\rightarrow h_1=\\varepsilon(x_1-x_2-0.5),h_2=\\varepsilon(x_2-x_1-0.5)\\rightarrow y=\\varepsilon(h_1+h_2-0.5)\n$$",
