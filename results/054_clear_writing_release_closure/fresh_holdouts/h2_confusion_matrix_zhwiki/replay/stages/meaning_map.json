  "meanings": [
    {
      "meaning_id": "definition",
      "kind": "technical_explanation",
      "normalized_meaning": "用途：分类结果可视化，尤其监督学习；无监督学习对应名称为匹配矩阵。结构：实际与预测两个维度，类别集合相同，属于列联表。命名反映类别误认。误差矩阵为同义名称，术语出处为国家教育研究院。",
      "source_anchor_ids": [
        "src-001",
        "src-002"
      ],
      "exact_item_ids": []
    },
    {
      "meaning_id": "example",
      "kind": "technical_explanation",
      "normalized_meaning": "测试条件：已训练的猫狗分类系统。样本总数13，猫8、狗5；行实际、列预测；猫行5和3，狗行2和3。主对角线正确，其他位置错误。",
      "source_anchor_ids": [
        "src-003"
      ],
      "exact_item_ids": [
        "e0",
        "e1",
        "e2",
        "e3",
        "e4"
      ]
    },
    {
      "meaning_id": "binary",
      "kind": "technical_explanation",
      "normalized_meaning": "二分类用两行两列报告真阳性、假阴性、假阳性、真阴性；除总体正确率外还可分解错误。以猫为阳性解释各格。",
      "source_anchor_ids": [
        "src-004"
      ],
      "exact_item_ids": []
    },
    {
      "meaning_id": "imbalance",
      "kind": "technical_explanation",
      "normalized_meaning": "不平衡条件：猫95、狗5，全部预测猫。总体准确度95%；猫敏感性100%，狗识别率0%。以猫为阳性时F1超过97.4%，仍掩盖狗的完全漏识别。不是所有F1汇总方式均取该数值。",
      "source_anchor_ids": [
        "src-004"
      ],
      "exact_item_ids": [
        "e5",
        "e6",
        "e7",
        "e8",
        "e9",
        "e10"
      ]
    },
    {
      "meaning_id": "youden",
      "kind": "technical_explanation",
      "normalized_meaning": "约登指数抵消此例类别比例导致的高分假象。敏感性加特异性减一；此例95/(95+0)+0/(0+5)-1=0，恒猜猫没有有效类别区分信息。零值表示在此判别意义上无用，不把指数误写成概率。文献身份：Youden’s J statistic，Wikipedia。",
      "source_anchor_ids": [
        "src-004",
        "src-005"
      ],
      "exact_item_ids": [
        "e11",
        "e12",
        "e13"
      ]
    },
    {
      "meaning_id": "other",
      "kind": "technical_explanation",
      "normalized_meaning": "可依据分析目的从混淆矩阵计算其他指标，不同指标用途不同。",
      "source_anchor_ids": [
        "src-006"
      ],
      "exact_item_ids": []
    }
  ],
