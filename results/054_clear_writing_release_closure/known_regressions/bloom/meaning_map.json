  "meanings": [
    {
      "exact_item_ids": [
        "E1",
        "E2",
        "E3",
        "E16"
      ],
      "kind": "definition",
      "meaning_id": "M1",
      "normalized_meaning": "对象=集合成员检验的概率数据结构；提出者=Burton Howard Bloom；年份=1970；出处=Bloom 1970；表示=经散列映射的二进制位数组；空间、查询时间效率优于一般算法；误报可能、漏报不会、删除困难。",
      "source_anchor_ids": [
        "src-005"
      ]
    },
    {
      "exact_item_ids": [
        "E4",
        "E5",
        "E6"
      ],
      "kind": "comparison",
      "meaning_id": "M2",
      "normalized_meaning": "常规方法保存全部元素再比较；链表、树、散列表（哈希表）的检索复杂度依次为O(n)、O(log n)、O(1)；集合增长带来存储增长及检索负担。",
      "source_anchor_ids": [
        "src-006"
      ]
    },
    {
      "exact_item_ids": [
        "E8",
        "E9",
        "E10"
      ],
      "kind": "mechanism",
      "meaning_id": "M3",
      "normalized_meaning": "参数m=数组位数；空数组全0；k个散列函数各映射到一个位置；理想散列均匀且独立；k通常为小常数，由目标误报率ε决定；m与k及待加元素数成正比。插入置1；查询任一0即排除，全1只表示可能存在，因为其他元素可能占据相同位置；简单结构无法区分，先进技术可解决。",
      "source_anchor_ids": [
        "src-007",
        "src-009",
        "src-010",
        "src-011"
      ]
    },
    {
      "exact_item_ids": [
        "E11",
        "E12",
        "E14",
        "E15"
      ],
      "kind": "example",
      "meaning_id": "M4",
      "normalized_meaning": "例子集合{x, y, z}；m = 18；k = 3；w映射位置出现0故不在集合；图中彩色箭头为映射，箭头数量表达散列函数数目。",
      "source_anchor_ids": [
        "src-008"
      ]
    },
    {
      "exact_item_ids": [
        "E13",
        "E17",
        "E18"
      ],
      "kind": "implementation",
      "meaning_id": "M5",
      "normalized_meaning": "k大时难构造多个独立函数；宽输出良好散列的位域相关性低，可切分输出获得多个函数；也可取0, 1, ..., k − 1作为初始值或加入/追加到键；m和/或k较大可放宽独立性，误报增幅可忽略，归于Dillinger、Manolios 2004a及Kirsch、Mitzenmacher 2006；Dillinger、Manolios 2004b展示增强双重散列、三重散列导出k索引的有效性，它们是双散列变体，以2或3个散列值播种简单随机数生成器。",
      "source_anchor_ids": [
        "src-012"
      ]
    },
    {
      "kind": "deletion",
      "meaning_id": "M6",
      "normalized_meaning": "简单结构无法安全删除：清任一对应位可排除目标，也可误排其他共享该位的元素；无占用归属判别机制，清位可能漏报。",
      "source_anchor_ids": [
        "src-013"
      ]
    },
    {
      "kind": "auxiliary",
      "meaning_id": "M7",
      "normalized_meaning": "辅助移除过滤器记录已删除元素，可模拟一次性删除；辅助结构误报转为组合结构漏报；已删除元素不可重新添加，因为需要从辅助结构删除，复遇同一困难。",
      "source_anchor_ids": [
        "src-014"
      ]
    },
    {
      "exact_item_ids": [
        "E7"
      ],
      "kind": "tradeoffs",
      "meaning_id": "M8",
      "normalized_meaning": "空间和时间优势；固定过滤器存储空间固定，插入/查询O(k)，小常数k使时间为常数；散列计算互不依赖，适合硬件并行；不存元素本身有利于严格保密场景。插入数增则误报率增，元素很少用散列表已足够，降低误报的研究产生许多变种。所有键常可取得但枚举昂贵（多次磁盘读）；误报过高可重建，重建应较少发生。",
      "source_anchor_ids": [
        "src-015",
        "src-016",
        "src-017"
      ]
    }
  ],
  "relations": [
    {
      "from_meaning": "M3",
      "relation": "共享位解释删除限制",
      "to_meaning": "M6"
    },
    {
      "from_meaning": "M6",
      "relation": "辅助结构不能消除删除困难",
      "to_meaning": "M7"
    }
  ],
